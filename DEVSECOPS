## Fail the pipeline on important Trivy findings

pipeline {
    agent any

    environment {
        IMAGE_NAME = "my-app"
        IMAGE_TAG = "jenkins-${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .'
            }
        }

        stage('Run Trivy Scan') {
            steps {
                sh '''
                docker run --rm \
                  -v /var/run/docker.sock:/var/run/docker.sock \
                  -v $WORKSPACE:/work \
                  aquasec/trivy:0.69.3 image \
                  --severity HIGH,CRITICAL \
                  --ignore-unfixed \
                  --exit-code 1 \
                  --format json \
                  --output /work/trivy-report.json \
                  ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'trivy-report.json', fingerprint: true, allowEmptyArchive: true
        }
    }
}




Add zap+juiceshop to the pipeline

pipeline {
    agent any

    environment {
        IMAGE_NAME = "my-app"
        IMAGE_TAG  = "jenkins-${BUILD_NUMBER}"
        ZAP_NET    = "zapnet"
        APP_NAME   = "juice-shop"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .'
            }
        }

        stage('Run Trivy Gate') {
            steps {
                sh '''
                docker run --rm \
                  -v /var/run/docker.sock:/var/run/docker.sock \
                  -v $WORKSPACE:/work \
                  aquasec/trivy:0.69.3 image \
                  --severity HIGH,CRITICAL \
                  --ignore-unfixed \
                  --exit-code 1 \
                  --format json \
                  --output /work/trivy-report.json \
                  ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Start Juice Shop') {
            steps {
                sh '''
                docker network inspect ${ZAP_NET} >/dev/null 2>&1 || docker network create ${ZAP_NET}
                docker rm -f ${APP_NAME} >/dev/null 2>&1 || true
                docker run -d --name ${APP_NAME} --network ${ZAP_NET} -p 4000:3000 bkimminich/juice-shop
                sleep 20
                curl -I http://localhost:4000
                '''
            }
        }

        stage('Run ZAP Baseline Scan') {
            steps {
                sh '''
                mkdir -p zap-reports

                docker run --rm -t \
                  --network ${ZAP_NET} \
                  -v $WORKSPACE/zap-reports:/zap/wrk/:rw \
                  ghcr.io/zaproxy/zaproxy:stable \
                  zap-baseline.py \
                  -t http://${APP_NAME}:3000 \
                  -J zap-report.json \
                  -r zap-report.html
                '''
            }
        }
    }

